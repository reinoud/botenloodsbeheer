# Kopieer naar .env (chmod 600) en vul de geheimen in. Zet nooit een .env in git.
# Wachtwoorden en sleutels alleen letters en cijfers, want ze komen in een database-URL:
#   openssl rand -hex 32

# productie of ontwikkeling. Buiten productie mag BASIS_URL http://localhost zijn.
APP_OMGEVING=ontwikkeling

# Vaste domeinnaam van de installatie, in productie altijd https:// (ADR-009). Lokaal:
BASIS_URL=http://localhost:8080
# Leeg laten: dan de host uit BASIS_URL. Passkeys hangen aan deze waarde.
WEBAUTHN_RP_ID=

# Ondertekent sessiecookies. Minstens 32 tekens.
SECRET_KEY=
# Versleutelt de TOTP-geheimen in de database. Een Fernet-sleutel, te maken met:
#   docker run --rm botenloods-app python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Kwijt of gewijzigd: alle beheerders met wachtwoord en TOTP moeten opnieuw worden uitgenodigd.
TOTP_SLEUTEL=

# Database. De eigenaar draait alleen de migraties; web, api en worker hebben elk een eigen rol.
# Een nieuwe rol in een bestaande installatie (zoals botenloods_api): wachtwoord hier invullen en
#   docker compose exec db sh /docker-entrypoint-initdb.d/rollen.sh
POSTGRES_PASSWORD=
DB_WEB_WACHTWOORD=
DB_TAKEN_WACHTWOORD=
DB_API_WACHTWOORD=

# API (ADR-009, ADR-012): standaard aan, alleen over het interne netwerk via Nginx op poort 8081.
# false weigert elke aanroep; wijzigen vraagt `docker compose up -d api`.
API_INGESCHAKELD=true
# Subnet van het netwerk koppeling (de integratiecontainer). Ook de standaardwhitelist van een
# robottoken uit `flask token robot`. Alleen wijzigen als het botst met een ander netwerk.
KOPPELNET=10.203.0.0/24

# Ledenbron (ADR-004): leeg (geen bron) of stub. De stub leest synthetische leden uit een bestand
# en is alleen voor ontwikkeling: compose.dev.yml zet hem aan. Het productie-image heeft geen fixtures.
LEDENBRON=
LEDENBRON_STUB_BESTAND=tests/fixtures/leden.json
# Tijdstip van de dagelijkse ledensynchronisatie in de worker, in de tijdzone TZ.
SYNC_TIJDSTIP=03:00

# Logo van de vereniging (ADR-008): JPEG, PNG of WebP in de map huisstijl naast
# docker-compose.yml, gelezen bij het starten van web. Een nieuw logo: bestand vervangen en
# `docker compose restart web`. Zonder (geldig) bestand toont de kopbalk alleen de naam.
LOGO_BESTAND=/huisstijl/logo.png

# Aantal vertrouwde proxy's voor het clientadres. Achter de meegeleverde Nginx: 1.
PROXY_HOPS=1
TZ=Europe/Amsterdam
LOG_NIVEAU=INFO
