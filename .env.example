# Kopieer naar .env (chmod 600) en vul de geheimen in. Zet nooit een .env in git.
# Wachtwoorden en sleutels alleen letters en cijfers, want ze komen in een database-URL:
#   openssl rand -hex 32

# productie of ontwikkeling. Buiten productie mag BASIS_URL http://localhost zijn.
APP_OMGEVING=ontwikkeling

# Vaste domeinnaam van de installatie, in productie altijd https:// (ADR-009). Lokaal:
BASIS_URL=http://localhost:8080
# De host uit BASIS_URL, voor de routers van Traefik (ADR-013). Moet gelijk zijn aan die host.
DOMEIN=localhost
# Naam van deze installatie op de host: voor de netwerken INSTALLATIE_voorkant en
# INSTALLATIE_koppeling en de namen van de routers in Traefik. Uniek per host.
INSTALLATIE=botenloods
# Certresolver van de gedeelde Traefik voor het certificaat van DOMEIN, via Let's Encrypt. Verplicht
# in productie, bijvoorbeeld letsencrypt zoals in documentatie/beheer/voorbeelden/traefik/; lokaal
# leeg (geen TLS).
TRAEFIK_CERTRESOLVER=
# Leeg laten: dan de host uit BASIS_URL. Passkeys hangen aan deze waarde.
WEBAUTHN_RP_ID=

# Ondertekent sessiecookies. Minstens 32 tekens.
SECRET_KEY=
# Versleutelt de TOTP-geheimen in de database. Een Fernet-sleutel, te maken met:
#   docker run --rm botenloods-app python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Kwijt of gewijzigd: alle beheerders met wachtwoord en TOTP moeten opnieuw worden uitgenodigd.
TOTP_SLEUTEL=

# Database. De eigenaar draait alleen de migraties; web, api en worker hebben elk een eigen rol.
# Een nieuwe rol in een bestaande installatie (zoals botenloods_api): wachtwoord hier invullen en
#   docker compose exec db sh /docker-entrypoint-initdb.d/rollen.sh
POSTGRES_PASSWORD=
DB_WEB_WACHTWOORD=
DB_TAKEN_WACHTWOORD=
DB_API_WACHTWOORD=

# API (ADR-009, ADR-012): standaard aan, alleen over het netwerk koppeling via Traefik op 8081.
# false weigert elke aanroep; wijzigen vraagt `docker compose up -d api web` (web toont de stand
# op de statuspagina).
API_INGESCHAKELD=true
# Subnet van het netwerk koppeling (de integratiecontainer). Ook de standaardwhitelist van een
# robottoken uit `flask token robot` en het enige bereik dat de router op intern doorlaat.
# Alleen wijzigen als het botst met een ander netwerk; gelijk aan het subnet van dat netwerk.
KOPPELNET=10.203.0.0/24
# Alleen met compose.api-extern.yml (API van buiten, ADR-013): de adressen of reeksen die de API van
# buiten mogen bereiken, gescheiden door komma's, bijvoorbeeld 203.0.113.0/24,2001:db8::/32. Leeg
# laat compose met dat bestand niet starten. 0.0.0.0/0,::/0 opent de API voor elk adres; dan
# begrenst alleen de whitelist van het token. Zie documentatie/beheer/api-van-buiten.md.
API_EXTERN_BRONNEN=

# Ledenbron van de integratiecontainer (ADR-004, ADR-012); de applicatie kent deze waarden niet.
# Leeg (geen bron), stub of eboekhouden. De stub leest synthetische leden uit een bestand en is
# alleen voor ontwikkeling: compose.dev.yml zet hem aan. Het token staat in secrets/api_token, niet
# hier; zie documentatie/beheer/integratiecontainer.md en integratie-werking.md.
LEDENBRON=
LEDENBRON_STUB_BESTAND=/data/leden.json
# Inloggegevens van e-boekhouden, alleen voor de dienst integratie en alleen bij
# LEDENBRON=eboekhouden (alle drie verplicht; de container start anders niet). Nooit committen.
EBOEKHOUDEN_USERNAME=
EBOEKHOUDEN_CODE1=
EBOEKHOUDEN_CODE2=
# Aantal boten per bootsoort terugschrijven naar vrij veld 10 in e-boekhouden na elke geslaagde
# import: aan of uit. Alleen met LEDENBRON=eboekhouden. Zet het pas aan na de live proef.
BOOTAANTALLEN_SCHRIJVEN=uit
# Adres van de API voor de integratiecontainer: het entrypoint intern van de gedeelde Traefik.
API_URL=http://traefik:8081/api/v1
# Tijdstip van de dagelijkse import in de integratiecontainer, in de tijdzone TZ.
SYNC_TIJDSTIP=03:00

# Logo van de vereniging (ADR-008): JPEG, PNG of WebP in de map huisstijl naast
# docker-compose.yml, gelezen bij het starten van web. Een nieuw logo: bestand vervangen en
# `docker compose restart web`. Zonder (geldig) bestand toont de kopbalk alleen de naam.
LOGO_BESTAND=/huisstijl/logo.png

# Aantal vertrouwde proxy's voor het clientadres. Achter Traefik: 1. Ook met een load balancer
# vóór Traefik blijft het 1: die geeft het clientadres door met het PROXY protocol
# (documentatie/beheer/installatie.md).
PROXY_HOPS=1
# Tijdstip van de dagelijkse opschoning na 5 jaar in de worker, in de tijdzone TZ (ADR-007).
OPSCHOON_TIJDSTIP=04:00
TZ=Europe/Amsterdam
LOG_NIVEAU=INFO
# Alleen voor de voorbeelden in documentatie/beheer/voorbeelden/: de versie van de images.
# VERSIE=1.2.3
